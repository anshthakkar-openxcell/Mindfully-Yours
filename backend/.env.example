# Mindfully Yours AI Service -- environment configuration
# Copy to .env and fill in real values. NEVER commit a real .env file.
# Per documnets/understanding/12_SECURITY_COMPLIANCE_DPDP.md: every vendor key below must belong
# to a confirmed no-training/no-retention account before any real data touches it.

# --- App ---
APP_ENV=development           # development | staging | production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Database (Postgres + pgvector) ---
# Per 11_DATA_MODEL_AND_STORAGE.md -- single data spine, AWS ap-south-1 in production.
DATABASE_URL=postgresql+asyncpg://mindfully:mindfully@localhost:5432/mindfully_ai
EMBED_DIM=1024                 # must match the embedding provider's output dimension

# --- Redis (cache + running conversation state) ---
# Per 09_LATENCY_AND_PERFORMANCE.md -- two-tier cache + Step B running state, single-digit-ms budget.
REDIS_URL=redis://localhost:6379/0

# --- LLM provider (primary: Sarvam-M) ---
# Per 03_TECH_STACK.md -- swappable behind app/providers/llm/base.py, never called directly.
LLM_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_API_BASE=https://api.sarvam.ai
LLM_FALLBACK_PROVIDER=        # e.g. openai -- comparison/fallback only, per 03_TECH_STACK.md

# --- Speech-to-text (primary: Deepgram) ---
# NOTE: 15_OPEN_QUESTIONS_AND_BLOCKERS.md #9 -- dual Deepgram/Sarvam vs Deepgram-only is unresolved.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# --- Text-to-speech (Sarvam TTS / Bulbul) ---
TTS_PROVIDER=sarvam

# --- Embeddings (Sarvam) ---
# Do not swap without a full KB re-embed -- see 07_INGESTION_PIPELINE.md §3.
EMBEDDING_PROVIDER=sarvam

# --- Avatar (vendor unresolved -- see 15_OPEN_QUESTIONS_AND_BLOCKERS.md #8) ---
AVATAR_PROVIDER=              # heygen | spatius | none -- leave unset until the technology review decides
AVATAR_ENABLED=false          # opt-in + cost-gated, per 03_TECH_STACK.md

# --- LiveKit (AI Companion Agent only -- see 10_LIVEKIT_REALTIME.md) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Safety / KB config ---
# Below-threshold retrieval confidence routes to the safe fallback, never a best-effort guess.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.75
REDFLAG_MATCH_THRESHOLD=0.55   # deliberately more permissive than normal RAG match -- 08_SAFETY_INTERLOCK_AND_TRIAGE.md §4
