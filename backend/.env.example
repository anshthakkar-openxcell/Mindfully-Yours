# Mindfully Yours AI Service -- environment configuration
# Copy to .env and fill in real values. NEVER commit a real .env file.
# Per documnets/understanding/12_SECURITY_COMPLIANCE_DPDP.md: every vendor key below must belong
# to a confirmed no-training/no-retention account before any real data touches it.

# --- App ---
APP_ENV=development           # development | staging | production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Database (Postgres + pgvector) ---
# Per 11_DATA_MODEL_AND_STORAGE.md -- single data spine, AWS ap-south-1 in production.
DATABASE_URL=postgresql+asyncpg://mindfully:mindfully@localhost:5432/mindfully_ai
EMBED_DIM=1024                 # must match the embedding provider's output dimension

# --- Redis (cache + running conversation state) ---
# Per 09_LATENCY_AND_PERFORMANCE.md -- two-tier cache + Step B running state, single-digit-ms budget.
REDIS_URL=redis://localhost:6379/0

# --- LLM provider (primary: Sarvam-M) ---
# Per 03_TECH_STACK.md -- swappable behind app/providers/llm/base.py, never called directly.
LLM_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_API_BASE=https://api.sarvam.ai
SARVAM_LLM_MODEL=sarvam-105b-conversations   # "sarvam-m" is deprecated; this one's tuned for real-time conversation
LLM_FALLBACK_PROVIDER=        # e.g. openai -- comparison/fallback only, per 03_TECH_STACK.md

# --- Speech-to-text (Sarvam Saaras, real-time streaming) ---
# RESOLVED 2026-10-01: Sarvam only, for both STT and TTS -- Deepgram is not used. See
# 15_OPEN_QUESTIONS_AND_BLOCKERS.md #9 for the discrepancy this overrides.
STT_PROVIDER=sarvam
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_STT_SAMPLE_RATE=16000   # caller must deliver mono linear16 PCM at this rate -- no resampling here

# --- Text-to-speech (Sarvam TTS / Bulbul, real-time streaming) ---
TTS_PROVIDER=sarvam
SARVAM_TTS_MODEL=bulbul:v3      # bulbul:v2 is deprecated server-side, confirmed live 2026-10-01
SARVAM_TTS_SPEAKER=shubh        # v3 speaker name -- v2/v3 speaker lists don't overlap
SARVAM_TTS_SAMPLE_RATE=24000

# --- Embeddings (OpenAI, NOT Sarvam) ---
# Sarvam has no embeddings product at all -- confirmed against their live model list + API
# reference (Sept 2026), not assumed. text-embedding-3-small was already the documented
# fallback/benchmark embeddings vendor (03_TECH_STACK.md), so it's promoted to primary here.
# EMBED_DIM above stays 1024 -- text-embedding-3-small's `dimensions` request parameter shortens
# its native 1536-length output to 1024 (Matryoshka representation learning; OpenAI's own docs
# confirm this preserves most retrieval quality), avoiding a re-migration of the Vector(1024)
# columns already created. Do not swap without a full KB re-embed -- see 07_INGESTION_PIPELINE.md §3.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # OpenAI's cheapest/fastest embedding model that still supports the `dimensions` shortening trick above; swap to text-embedding-3-large only if retrieval quality genuinely needs it -- see reasoning in app/providers/embeddings/openai_embeddings.py

# --- Avatar (vendor unresolved -- see 15_OPEN_QUESTIONS_AND_BLOCKERS.md #8) ---
AVATAR_PROVIDER=              # heygen | spatius | none -- leave unset until the technology review decides
AVATAR_ENABLED=false          # opt-in + cost-gated, per 03_TECH_STACK.md

# --- LiveKit (AI Companion Agent only -- see 10_LIVEKIT_REALTIME.md) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Safety / KB config ---
# Below-threshold retrieval confidence routes to the safe fallback, never a best-effort guess.
# RECALIBRATED 2026-09-28 for OpenAI text-embedding-3-small (the original 0.75/0.55 were guessed
# for Sarvam's embedding space, which turned out not to exist -- see
# 15_OPEN_QUESTIONS_AND_BLOCKERS.md #28). These are a data-informed starting point from a small
# manual test, NOT a validated threshold -- see the comment in .env for the real numbers behind
# this, and do not treat this as production-ready without a real validation set.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.30
REDFLAG_MATCH_THRESHOLD=0.44   # deliberately more permissive than normal RAG match -- 08_SAFETY_INTERLOCK_AND_TRIAGE.md §4
# Soft-zone upper bound for the small set of flags in app.safety.interlock.SOFT_ZONE_ELIGIBLE_FLAGS
# (currently just RF-028) -- a match between REDFLAG_MATCH_THRESHOLD and this gets a gentle real
# clarifying question instead of a hard escalation. See .env for the live-tested false-positive
# example behind this (0.55), and 15_OPEN_QUESTIONS_AND_BLOCKERS.md #28. Never applied to
# suicide/self-harm flags.
REDFLAG_SOFT_ZONE_THRESHOLD=0.55
# Lower, more sensitive threshold for RF-018/RF-019 (suicide ideation) specifically -- see .env for
# the live-tested numbers behind this (including why RF-025 was deliberately left out) and
# app/safety/interlock.py's CRITICAL_SELF_HARM_FLAGS docstring for the full reasoning.
REDFLAG_CRITICAL_THRESHOLD=0.36
RETRIEVAL_TOP_K=3   # max candidate chunks considered before RETRIEVAL_CONFIDENCE_THRESHOLD filters them -- a ceiling, not a guarantee

# --- Triage thresholds (app.safety.triage -- signal/symptom/pattern recognition) ---
# See .env for the full reasoning and the live-tested false-positive example behind 0.45.
TRIAGE_SIGNAL_THRESHOLD=0.45
TRIAGE_TOP_K=5
PATTERN_MATCH_THRESHOLD=0.30

# --- Tier scoring (app.pipeline.tier_scoring) -- see .env and 28_TIER_SCORING_APPROACH.md ---
# Only one cutoff -- there is deliberately no score-based Tier 3; Tier 3 is exclusively the safety
# interlock's crisis path. See .env for the full reasoning.
TIER2_SCORE_MIN=40
TIER_SCORE_DECAY_PER_QUIET_TURN=5
TIER_SCORE_MAX_GAIN_PER_TURN=25
REDIRECT_MIN_DISTINCT_SIGNALS=3

# --- Therapist-first response (doc 32) -- PROVISIONAL until calibrated with a therapist-labelled set ---
CURATED_MATCH_ENABLED=true
CURATED_STRONG_SIMILARITY=0.85
CURATED_PARTIAL_SIMILARITY=0.62
CURATED_NON_OPENING_MARGIN=0.05
CURATED_PARTIAL_MODE=rephrase    # rephrase | verbatim
CURATED_CLARIFY_LIMIT=1
CURATED_TOP_K=5
CURATED_MAX_EXAMPLES=3

# --- Translation for Hindi / Hinglish users (doc 34) ---
TRANSLATION_ENABLED=true
SARVAM_TRANSLATE_MODEL=mayura:v1
TRANSLATION_TIMEOUT_SECONDS=5.0
